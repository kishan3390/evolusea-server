{
  "name": "evolusea-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "generate:metadata": "ts-node ./bin/generateMetadata.ts",
    "lint": "eslint",
    "migration:autogenerate": "yarn run typeorm migration:generate",
    "migration:create": "yarn run typeorm migration:create",
    "migration:down": "yarn run typeorm migration:revert",
    "migration:up": "yarn typeorm migration:run",
    "typeorm": "typeorm-ts-node-commonjs -d ormconfig.ts",
    "prebuild": "rimraf dist && yarn run generate:metadata",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e": "TESTCONTAINERS_RYUK_DISABLED=true vitest run --config ./test/vitest.config.e2e.mts",
    "test:e2e:verbose": "yarn run test:e2e --reporter=verbose",
    "test:smoke-tests": "vitest run --config ./smoke-tests/vitest.config.smoke-tests.mts",
    "test:watch": "vitest --watch"
  },
